# Copy to .env (or .env.local) and set per environment.
#
# VITE_API_BASE — absolute base URL of the backend API. Fully env-driven.
#   local dev : http://localhost:8000/api
#   prod      : https://api.<your-domain>/api   (the deployed backend origin)
#
# Note: an absolute cross-origin base means the backend must send CORS
# headers (Access-Control-Allow-Origin / -Credentials). This is a conscious
# divergence from archi AD6 (Amplify same-origin /api reverse-proxy).
VITE_API_BASE=http://localhost:8000/api
