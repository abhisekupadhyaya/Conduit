#!/bin/bash
set -euxo pipefail

# --- Register this instance to the Conduit ECS cluster ---------------------
mkdir -p /etc/ecs
{
  echo "ECS_CLUSTER=${cluster_name}"
  echo "ECS_ENABLE_CONTAINER_METADATA=true"
} >> /etc/ecs/ecs.config

# --- Install Caddy (AD2: TLS termination + reverse proxy on the host) ------
# Static binary for arm64 (t4g = Graviton) — deterministic, no extra repos.
curl -fsSL "https://caddyserver.com/api/download?os=linux&arch=arm64" \
  -o /usr/local/bin/caddy
chmod +x /usr/local/bin/caddy
useradd --system --home /var/lib/caddy --shell /usr/sbin/nologin caddy || true
mkdir -p /var/lib/caddy /etc/caddy

cat > /etc/caddy/Caddyfile <<'CADDY'
${api_fqdn} {
%{ if acme_email != "" ~}
	tls ${acme_email}
%{ endif ~}
	reverse_proxy localhost:${host_port}
}
CADDY

cat > /etc/systemd/system/caddy.service <<'UNIT'
[Unit]
Description=Caddy
After=network.target

[Service]
User=caddy
Group=caddy
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now caddy
