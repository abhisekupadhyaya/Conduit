# Conduit backend env — copy to .env (git-ignored). Settings prefix: CONDUIT_

# --- App ---
CONDUIT_ENV=local
# Frontend calls an absolute base http://localhost:8000/api, so the API is
# served under /api and CORS is enabled for the SPA origin (the conscious
# AD6 divergence: backend owns CORS instead of an Amplify same-origin proxy).
CONDUIT_API_PREFIX=/api
CONDUIT_CORS_ORIGINS=http://localhost:5173

# --- Database (local: the docker-compose Postgres = the RDS alternative, AD3) ---
# In-container you reach it by service name on the INTERNAL port (not 5435).
CONDUIT_DATABASE_URL=postgresql+asyncpg://conduit:conduit@postgres:5432/conduit

# --- Auth (app-managed JWT, AD8) ---
CONDUIT_JWT_SECRET=dev-only-change-me
CONDUIT_JWT_ALG=HS256
CONDUIT_JWT_TTL_MINUTES=720

# --- LLM (external OpenAI, bulkheaded — AD11) ---
CONDUIT_OPENAI_API_KEY=
CONDUIT_OPENAI_MODEL=gpt-5.4-mini
CONDUIT_OPENAI_BASE_URL=https://api.openai.com/v1
CONDUIT_OPENAI_TIMEOUT_SECONDS=20

# --- Object storage (local: the docker-compose MinIO = the S3 alternative) ---
CONDUIT_S3_ENDPOINT_URL=http://minio:9000
CONDUIT_S3_REGION=us-east-1
CONDUIT_S3_ACCESS_KEY=conduit
CONDUIT_S3_SECRET_KEY=conduit_secret
CONDUIT_S3_BUCKET=conduit
CONDUIT_S3_FORCE_PATH_STYLE=true

# --- Lifecycle engine (in-process, AD4/AD5) ---
CONDUIT_ENGINE_ENABLED=true
CONDUIT_ENGINE_POLL_SECONDS=10
